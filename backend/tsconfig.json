{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "moduleResolution": "node10",
    "module": "commonjs",
    "target": "es2020",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src"],
  "exclude": ["src/**/__tests__/**"]
}
